{
  "manifest_version": 3,
  "name": "Threat Analyze - Real-Time SOC Browser Shield",
  "version": "2.4.0",
  "description": "Proactive AI URL and domain cybersecurity scanner before navigation.",
  "permissions": [
    "webNavigation",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Threat Analyze Shield"
  }
}
